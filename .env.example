# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.
# The test script will also prompt interactively for any of these that are missing.

# RHACS Central API endpoint (no https:// prefix, no port - the scripts add :443)
# ACSCS example: acs-xxxxxxxxxxxxxxxxxxxx.acs.rhcloud.com
ROX_CENTRAL_ENDPOINT=

# RHACS API token (Central -> Platform Configuration -> Integrations -> Authentication Tokens -> API Token)
# Needs at least: Analyst (read) role for verification; Admin only if you want the script to also manage policies.
ROX_API_TOKEN=

# OpenShift namespace to deploy the test workloads into
TEST_NAMESPACE=acs-init-container-test
